# 1radiœ: document root of the domain (www/ of the git checkout)
# No MultiViews: otherwise Apache maps api/status to api/status.php by itself, before the
# rewrite rules below, compares the file type with the Accept header and answers 406 to
# "Accept: application/json" (the web app asks for the listening status that way).
Options -Indexes -MultiViews

# No hidden files (.htaccess, .user.ini, editor leftovers)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Public addresses without file extension. app/dev-router.php mirrors these rules
# for PHP's built-in server, keep both in sync.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Plain HTTP goes to HTTPS. Only GET and HEAD: a POST (Sonos, Home Assistant) would
    # lose its body on a redirect, those clients use HTTPS anyway.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    # German under /de/: every address works there as well, the page reads the language
    # from REQUEST_URI (which keeps /de/). /de gets its slash, so relative links stay right.
    RewriteRule ^de$ /de/ [R=301,L]
    RewriteRule ^de/(.*)$ /$1 [L]
    # scripts with the version in the path (assets/v1.30.0/app.js, also in admin/): the ES
    # modules an entry loads relative to itself carry the version that way (index.php,
    # app/admin.php). The files themselves lie in assets/ without it.
    RewriteRule ^(admin/)?assets/v[0-9][0-9.]*/(.+)$ $1assets/$2 [L]
    RewriteRule ^api/status$ api/status.php [L]
    RewriteRule ^api/listen$ api/listen.php [L]
    RewriteRule ^api/nowplaying$ api/nowplaying.php [L]
    RewriteRule ^api/stations\.json$ api/stations.php [L]
    RewriteRule ^api/playlists$ api/playlists.php [L]
    RewriteRule ^streams\.m3u$ playlist.php [L]
    RewriteRule ^streams\.xspf$ xspf.php [L]
    # gone since 1.13.0: the PLS list and the playlist of a single station
    RewriteRule ^streams\.pls$ - [G]
    RewriteRule ^s/[A-Za-z0-9._-]+\.m3u$ - [G]
    RewriteRule ^s/([A-Za-z0-9._-]+)$ index.php?s=$1&go=1 [L]
    # Sonos playback reports: Reporting Endpoint …/report/v2.3, Sonos appends /timePlayed
    RewriteRule ^report/ report.php [L]
</IfModule>

# Browsers keep to HTTPS for a year once they were here (HSTS), only on HTTPS answers.
# Without includeSubDomains and preload: other subdomains are not known to run HTTPS.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# Search engines may index the web app (robots.txt keeps them off the admin, the
# interfaces and the tracks; the admin also says noindex itself). Until 1.21 a
# header kept the whole site out of the index.
