# 1radiœ: document root of the domain (www/ of the git checkout)
# No MultiViews: otherwise Apache maps api/status to api/status.php by itself, before the
# rewrite rules below, compares the file type with the Accept header and answers 406 to
# "Accept: application/json" (the web app asks for the listening status that way).
Options -Indexes -MultiViews

# No hidden files (.htaccess, .user.ini, editor leftovers)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Public addresses without file extension. app/dev-router.php mirrors these rules
# for PHP's built-in server, keep both in sync.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # German under /de/: every address works there as well, the page reads the language
    # from REQUEST_URI (which keeps /de/). /de gets its slash, so relative links stay right.
    RewriteRule ^de$ /de/ [R=301,L]
    RewriteRule ^de/(.*)$ /$1 [L]
    RewriteRule ^api/status$ api/status.php [L]
    RewriteRule ^api/listen$ api/listen.php [L]
    RewriteRule ^api/nowplaying$ api/nowplaying.php [L]
    RewriteRule ^api/stations\.json$ api/stations.php [L]
    RewriteRule ^streams\.m3u$ playlist.php [L]
    # gone since 1.13.0: the PLS list and the playlist of a single station
    RewriteRule ^streams\.pls$ - [G]
    RewriteRule ^s/[A-Za-z0-9._-]+\.m3u$ - [G]
    RewriteRule ^s/([A-Za-z0-9._-]+)$ index.php?s=$1&go=1 [L]
    # Sonos playback reports: Reporting Endpoint …/report/v2.3, Sonos appends /timePlayed
    RewriteRule ^report/ report.php [L]
</IfModule>

# Personal project, not meant for search engines (see robots.txt)
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
