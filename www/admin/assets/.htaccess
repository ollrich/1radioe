# 1radiœ: browser cache for the files of the admin. Addresses with ?v= or with the version
# in the path (assets/v1.30.0/app.js and its modules) change with every version, so
# browsers may keep them for a year without asking again; the rest for a week.
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=/ || %{THE_REQUEST} =~ m#/assets/v[0-9]#"
    Header set Cache-Control "public, max-age=604800" "expr=%{QUERY_STRING} !~ /(^|&)v=/ && %{THE_REQUEST} !~ m#/assets/v[0-9]#"
</IfModule>
